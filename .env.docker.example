# Copy to .env for the containers:  cp .env.docker.example .env
# Then fill in the Supabase values your owner gives you. NEVER commit .env.

# --- Store: point every container at the ONE shared research map ---
POPPER_STORE=supabase                       # keep as "supabase" so all writes land in the shared DB
POPPER_SUPABASE_URL=https://YOUR-PROJECT.supabase.co   # from the owner
POPPER_SUPABASE_KEY=YOUR-ANON-KEY           # anon key from the owner

# --- Anthropic (only needed for RUN_MODE=llm; leave blank for $0 seeded mode) ---
POPPER_ANTHROPIC_API_KEY=                   # sk-ant-... (alias ANTHROPIC_API_KEY also works)

# --- Run knobs (read by docker-entrypoint.sh) ---
RUN_MODE=llm                                # seeded = $0 no-API smoke | llm = spends Anthropic per explore
RUN_MINUTES=60                              # wall-clock budget per llm batch
RUN_ITERATIONS=12                           # iterations per batch
RUN_SLEEP=30                                # seconds to sleep between batches
