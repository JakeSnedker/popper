# Containers currently run the dashboard/shared DB and seeded smoke only.
# Subscription generation runs on the host so each operator can authenticate the
# official Claude and Codex CLIs with their own account. Never commit populated .env.

POPPER_STORE=supabase
POPPER_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
POPPER_SUPABASE_KEY=YOUR-ANON-KEY
POPPER_EMBED_BACKEND=local

RUN_MODE=seeded
RUN_SLEEP=3600
