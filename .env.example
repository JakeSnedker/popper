# Copy to .env. Never commit .env.

# --- Alpha memory ---
POPPER_STORE=sqlite
POPPER_DB_PATH=popper.db
POPPER_SUPABASE_URL=
POPPER_SUPABASE_KEY=
# Required after team RLS is activated. Use one Auth account per operator.
POPPER_SUPABASE_EMAIL=
POPPER_SUPABASE_PASSWORD=
POPPER_AUTH_REQUIRED=false

# --- Node attribution ---
# Required for production nodes. operator_id is a local label; Supabase writes
# use the authenticated Auth UUID enforced by RLS instead.
POPPER_OPERATOR_ID=
POPPER_MACHINE_ID=
POPPER_RELEASE_ID=
# Example: ftmo-us30-v1@<full aggregate sha256>. Auto-read locally when blank.
POPPER_DATASET_ID=
# Dataset is distributed separately and may be on another drive.
POPPER_DATASET_DIR=data/ftmo-us30-v1

# --- Zero-marginal-cost LLM routing ---
# Claude and Codex use official subscription OAuth. OpenCode supplies the
# approved free hosted DeepSeek model; no DeepSeek/NVIDIA API key is used.
POPPER_LLM_BACKEND=subscriptions
# auto detects claude_cli, codex_cli and opencode_cli. Set an explicit list only
# to deliberately hold a provider back.
POPPER_LLM_PROVIDERS=auto
POPPER_LLM_ROUTE_POLICY=round_robin
POPPER_LLM_BATCH_SIZE=10
POPPER_LLM_FIDELITY_MODE=strict
POPPER_LLM_SURVIVOR_AUDIT=true
# False prevents a Codex CLI API-key login from silently spending metered credits.
POPPER_LLM_ALLOW_METERED_CODEX_CLI=false
# Claude reserve: node stops using claude_cli after this many calls per
# rolling window, leaving the rest of the session limit for Claude Code.
# Research keeps running on Codex + opencode/DeepSeek. 0 disables the cap.
POPPER_LLM_CLAUDE_MAX_CALLS_PER_WINDOW=60
POPPER_LLM_CLAUDE_RESERVE_WINDOW_HOURS=5
POPPER_LLM_PROVIDER_BACKOFF_SECONDS=300
POPPER_LLM_RATE_LIMIT_BACKOFF_SECONDS=2700

# --- Research allocation ---
# explore  = 90% new hypotheses / 10% wildcard
# balanced = 70% exploit / 20% explore / 10% wildcard
# exploit  = historical rescue only; initializes no LLM provider
# auto     = explore normally, then bounded exploit during provider backoff
POPPER_RESEARCH_MODE=auto
POPPER_RESCUE_BACKLOG=true
POPPER_RESCUE_BACKLOG_LIMIT=200
POPPER_RESCUE_BACKLOG_BAND=0.1
POPPER_AUTO_EXPLOIT_BATCH_SIZE=1
# Full manual exploit depth vs one-candidate probe during provider cooldown.
POPPER_EXPLOIT_MAX_EVALS=24
POPPER_AUTO_EXPLOIT_MAX_EVALS=1

POPPER_LLM_HYPOTHESIS_ROUTE=claude_cli:sonnet,codex_cli:default,opencode_cli:deepseek
POPPER_LLM_HYPOTHESIS_STRONG_ROUTE=codex_cli:default,claude_cli:sonnet
POPPER_LLM_WILDCARD_ROUTE=codex_cli:default,opencode_cli:deepseek,claude_cli:opus
POPPER_LLM_SYNTHESIS_ROUTE=claude_cli:haiku,codex_cli:default,opencode_cli:deepseek
POPPER_LLM_SYNTHESIS_STRONG_ROUTE=codex_cli:default,claude_cli:sonnet,opencode_cli:deepseek
POPPER_LLM_AUDIT_ROUTE=codex_cli:default,claude_cli:opus

# --- Novelty embeddings (small CPU hash, not a local LLM) ---
# Keep local for an existing map. Upgrade explicitly with reembed_hypotheses.py.
POPPER_EMBED_BACKEND=local

# --- API ---
POPPER_API_HOST=127.0.0.1
POPPER_API_PORT=8000
POPPER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
