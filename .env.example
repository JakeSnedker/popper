# Copy to .env and fill in. Never commit .env.

# Store: "sqlite" (default, runs now) or "supabase"
POPPER_STORE=sqlite
POPPER_DB_PATH=popper.db

# Supabase (only when POPPER_STORE=supabase)
POPPER_SUPABASE_URL=
POPPER_SUPABASE_KEY=

# Agents (Phase 6)
POPPER_ANTHROPIC_API_KEY=

# API
POPPER_API_HOST=127.0.0.1
POPPER_API_PORT=8000
POPPER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
